{
  "name": "MoneyMint Telegram transaction capture",
  "nodes": [
    {
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [200, 300],
      "credentials": { "telegramApi": { "name": "Connect your Telegram bot" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MONEYMINT_API_URL + '/api/integrations/telegram/process' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-telegram-webhook-secret", "value": "={{ $env.MONEYMINT_TELEGRAM_WEBHOOK_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { chatId: $json.message.chat.id, chatType: $json.message.chat.type, text: $json.message.text, updateId: $json.update_id } }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "moneymint-api",
      "name": "Create MoneyMint transaction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [{ "id": "command-or-transaction-completed", "leftValue": "={{ !!($json.transaction || $json.reply) }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-success",
      "name": "Transaction saved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [670, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.reply || ('✅ ' + ($json.transaction.type === 'income' ? 'Income' : 'Expense') + ' added\\n₹' + Number($json.transaction.amount).toLocaleString('en-IN') + ' → ' + $json.transaction.category) }}",
        "additionalFields": {}
      },
      "id": "telegram-success",
      "name": "Confirm in Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [920, 210],
      "credentials": { "telegramApi": { "name": "Connect your Telegram bot" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.message || 'MoneyMint could not add that transaction. Try “spent 150 food”.' }}",
        "additionalFields": {}
      },
      "id": "telegram-failure",
      "name": "Explain what needs fixing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [920, 390],
      "credentials": { "telegramApi": { "name": "Connect your Telegram bot" } }
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Create MoneyMint transaction", "type": "main", "index": 0 }]] },
    "Create MoneyMint transaction": { "main": [[{ "node": "Transaction saved?", "type": "main", "index": 0 }]] },
    "Transaction saved?": { "main": [[{ "node": "Confirm in Telegram", "type": "main", "index": 0 }], [{ "node": "Explain what needs fixing", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
